# ---------------------------------------------------------------
# Base de dados
#
# Fase 1 (demonstração): deixe DATABASE_URL vazio. O site usa um
# PostgreSQL embutido (PGlite) guardado em .dados/pglite, com
# migrações e dados de demonstração aplicados no arranque.
#
# Fase 2 (produção): connection string do PostgreSQL gerido, ex.:
#   postgresql://utilizador:palavra-passe@servidor/ddress?sslmode=require
# ---------------------------------------------------------------
DATABASE_URL=""

# ---------------------------------------------------------------
# Segredo das sessões — OBRIGATÓRIO em produção:
#   openssl rand -base64 48
# Em desenvolvimento, se ficar vazio, usa-se um valor local.
# ---------------------------------------------------------------
AUTH_SECRET=""

# Endereço público do site (links em mensagens e pagamentos)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------
# Pagamento com cartão (opcional — Fase 2)
# Deixe vazio para esconder a opção "Cartão" no checkout.
# ---------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
