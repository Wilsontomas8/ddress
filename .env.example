# ---------------------------------------------------------------
# Base de dados PostgreSQL
# Local:  postgresql://postgres:postgres@localhost:5432/ddress
# Neon / Supabase: copie a "connection string" do painel
# ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ddress?schema=public"

# ---------------------------------------------------------------
# Segredo das sessões — GERE UM NOVO ANTES DE IR PARA PRODUÇÃO:
#   openssl rand -base64 48
# ---------------------------------------------------------------
AUTH_SECRET="troque-este-segredo-por-um-valor-aleatorio-longo"

# Endereço público do site (usado em links de e-mail e pagamentos)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------
# Pagamento com cartão (opcional — Stripe)
# Deixe vazio para esconder a opção "Cartão" no checkout.
# ---------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
