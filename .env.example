# =================================================================
#  DDRESS — variáveis de ambiente
#  Copie para .env (local) ou defina na Vercel (Settings → Environment
#  Variables). Nunca coloque valores reais neste ficheiro: o repositório
#  é público.
# =================================================================

# -----------------------------------------------------------------
# Base de dados
#
# Local / Fase 1: deixe vazio. O site usa um PostgreSQL embutido (PGlite)
# em .dados/pglite, com migrações e dados de demonstração no arranque.
#
# Produção (Supabase): a integração Supabase ↔ Vercel cria POSTGRES_URL e
# POSTGRES_URL_NON_POOLING automaticamente — não é preciso mais nada.
# Sem a integração, use a connection string do pooler (Connect → ORMs):
#   DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres"
# e, para migrações, a ligação directa (porta 5432):
#   DATABASE_URL_DIRECT="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"
# -----------------------------------------------------------------
DATABASE_URL=""
DATABASE_URL_DIRECT=""

# -----------------------------------------------------------------
# Sessões. Com base real é obrigatório um destes:
#   AUTH_SECRET (gere com: openssl rand -base64 48), ou
#   SUPABASE_JWT_SECRET (criado pela integração do Supabase na Vercel).
# -----------------------------------------------------------------
AUTH_SECRET=""

# Palavra-passe da conta de administrador atendimentoddress@gmail.com,
# aplicada a cada implantação (mínimo 10 caracteres).
DDRESS_SENHA_ADMIN=""

# Endereço público do site (links em mensagens e pagamentos)
NEXT_PUBLIC_SITE_URL="https://ddress.vercel.app"

# Tarefa agendada que expira reservas sem prova
CRON_SECRET=""

# -----------------------------------------------------------------
# E-mails de aviso (pedidos, mudanças de estado, solicitações).
# Sem nada disto, os avisos no site funcionam e os e-mails ficam registados
# como "por configurar" (podem ser reenviados no painel).
#
# Opção A — Gmail da loja: active a verificação em 2 passos em
# atendimentoddress@gmail.com e crie uma "palavra-passe de aplicação".
#   SMTP_HOST="smtp.gmail.com"  SMTP_PORT="465"
#   SMTP_USER="atendimentoddress@gmail.com"  SMTP_PASS="<palavra-passe de aplicação>"
# Opção B — Resend: RESEND_API_KEY (tem prioridade sobre o SMTP).
# -----------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
EMAIL_REMETENTE="DDRESS <atendimentoddress@gmail.com>"

# Pagamento com cartão (Fase 2) — vazio esconde a opção no checkout
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
