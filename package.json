{
  "name": "ddress",
  "version": "1.0.0",
  "private": true,
  "description": "DDRESS — Aluguer e venda de vestidos. Loja online com secções Homem, Mulher e Criança, marcação de prova no ateliê e painel de gestão de pedidos.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts && drizzle-kit push && tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test": "tsx --test src/lib/*.test.ts",
    "e2e:cliente": "node scripts/e2e-cliente.mjs",
    "e2e:painel": "node scripts/e2e-painel.mjs",
    "imagens": "node scripts/gerar-imagens.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "eslint-config-next": "^16.3.5",
    "jose": "^5.9.6",
    "next": "^15.5.25",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
