{
  "name": "ddress",
  "version": "1.0.0",
  "private": true,
  "description": "DDRESS — Aluguer e venda de vestidos. Loja online com secções Homem, Mulher e Criança, marcação de prova no ateliê e painel de gestão de pedidos.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrar.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts && tsx src/db/migrar.ts && tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "e2e:cliente": "node scripts/e2e-cliente.mjs",
    "e2e:painel": "node scripts/e2e-painel.mjs",
    "imagens": "node scripts/gerar-imagens.mjs",
    "e2e:perfis": "node scripts/e2e-perfis.mjs",
    "e2e:conteudos": "node scripts/e2e-conteudos.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e-perfis.mjs && node scripts/e2e-cliente.mjs && node scripts/e2e-painel.mjs && node scripts/e2e-conteudos.mjs && node scripts/e2e-contas.mjs && node scripts/e2e-ficheiros.mjs",
    "capturas": "node scripts/capturas.mjs",
    "vercel-build": "tsx src/db/implantar.ts && next build",
    "db:implantar": "tsx src/db/implantar.ts",
    "e2e:contas": "node scripts/e2e-contas.mjs",
    "e2e:ficheiros": "node scripts/e2e-ficheiros.mjs",
    "db:diagnostico": "tsx src/db/diagnostico.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "eslint-config-next": "^16.3.5",
    "jose": "^5.9.6",
    "lucide-react": "^1.47.0",
    "next": "^15.5.25",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.1.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1"
  }
}
